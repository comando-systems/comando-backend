# Database
DB_NAME=comando
DB_PASS=comando
DB_USER=comando
DB_HOST=postgres

# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
NGINX_PORT=80

# JWT access tokens. Use a random value with at least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=comando
JWT_AUDIENCE=comando-api
JWT_EXPIRES_IN_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# Server processes sharing the port. Each keeps its own database pools (about 20 connections).
WEB_CONCURRENCY=1

# HTTP hardening
# Comma separated origins. `*` is rejected when NODE_ENV=production.
CORS_ORIGIN=*
BODY_LIMIT_BYTES=1048576
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Logging
LOG_LEVEL=info

# Interactive API reference at /docs and the contract at /openapi.json (no authentication).
# Unset: on outside production, off in production.
API_DOCS_ENABLED=true
