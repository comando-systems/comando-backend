# Database settings used by docker-compose to build its connection URLs.
DB_NAME=comando
DB_PASS=comando
DB_USER=comando
DB_HOST=postgres

# Connection URLs for host-run commands (dev, migrations, scripts).
# Compose overrides these with URLs built from the DB_* values above.
DATABASE_READ_URL=postgres://comando:comando@localhost:5432/comando?sslmode=disable
DATABASE_WRITE_URL=postgres://comando:comando@localhost:5432/comando?sslmode=disable

# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
NGINX_PORT=80

# JWT access tokens. Use a random value with at least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=comando
JWT_AUDIENCE=comando-api
JWT_EXPIRES_IN_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# Server processes sharing the port. Each keeps its own database pools (about 20 connections).
WEB_CONCURRENCY=1
# Reuse list totals (orders, items) for this many ms instead of counting on every page request.
LIST_COUNT_CACHE_TTL_MS=2000

# HTTP hardening
# Comma separated origins. `*` is rejected when NODE_ENV=production.
CORS_ORIGIN=*
BODY_LIMIT_BYTES=1048576
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Logging
LOG_LEVEL=info

# Item image uploads. Leave IMAGE_STORAGE_DIR unset to disable uploads; external imageUrl links
# still work. IMAGE_PUBLIC_BASE_URL must be a root-relative path and IMAGE_MAX_BYTES defaults to 5 MiB.
IMAGE_STORAGE_DIR=
IMAGE_PUBLIC_BASE_URL=/images
IMAGE_MAX_BYTES=5242880

# Interactive API reference at /docs and the contract at /openapi.json (no authentication).
# Unset: on outside production, off in production.
API_DOCS_ENABLED=true

# Bootstrap user created by the idempotent root seed (password: 12+ characters).
# This is the only bootstrap user; create further administrators through the API.
ROOT_EMAIL=root@comando.com
ROOT_PASSWORD=replace-with-a-strong-password
