# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# PostgreSQL connections used by the API. Both point to the same database for now.
DATABASE_READ_URL=postgres://comando:change-me@localhost:5432/comando?sslmode=disable
DATABASE_WRITE_URL=postgres://comando:change-me@localhost:5432/comando?sslmode=disable

# Better Auth. Use a random secret with at least 32 characters (openssl rand -hex 32).
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
# URL scheme of the mobile app; trusted for redirects after sign-in.
APP_SCHEME=comando

# HTTP hardening
CORS_ORIGIN=*
BODY_LIMIT_BYTES=1048576
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Logging
LOG_LEVEL=info
