# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# PostgreSQL connections used by the API. Both point to the same database for now.
DATABASE_READ_URL=postgres://comando:change-me@localhost:5432/comando?sslmode=disable
DATABASE_WRITE_URL=postgres://comando:change-me@localhost:5432/comando?sslmode=disable

# JWT access tokens. Use a random value with at least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=comando
JWT_AUDIENCE=comando-api
JWT_EXPIRES_IN_SECONDS=900

# HTTP hardening
CORS_ORIGIN=*
BODY_LIMIT_BYTES=1048576
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Logging
LOG_LEVEL=info
