# Porta publicada no host (somente o nginx é exposto)
HTTP_PORT=80

# Postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=comando
DB_USER=comando
# Evite caracteres especiais não escapados: a senha entra na DATABASE_URL
DB_PASS=

# API
# Localmente (bun run dev), a API usa DATABASE_URL diretamente.
DATABASE_URL=postgres://comando:change-me@localhost:5432/comando
# Divida em um valor longo e aleatório antes de usar em produção.
JWT_SECRET=change-me
TOKEN_TTL_SECONDS=28800

# Administrador inicial (opcional, usado por `bun run db:seed`)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
