{
  "name": "comando-backend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "check": "bun run typecheck && bun run check:imports",
    "check:imports": "bun scripts/check-imports.ts",
    "typecheck": "bun check --no-script",
    "test": "bun test",
    "dev": "bun --hot api/index.ts",
    "build": "bun build api/index.ts --target=bun --outdir ./out",
    "db:seed": "bun scripts/database/seed.ts"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
