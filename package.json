{
  "name": "comando-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:e2e": "bun test tests/e2e",
    "test:all": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage",
    "db:migrate:up": "migrate -path migrations -database \"$DATABASE_WRITE_URL\" up",
    "db:migrate:down": "migrate -path migrations -database \"$DATABASE_WRITE_URL\" down 1",
    "db:create-admin": "bun scripts/create-admin.ts",
    "docker:build": "docker build -f infra/api/Dockerfile -t comando-backend .",
    "docker:db": "docker compose -f infra/docker-compose.yml --env-file .env up -d postgres",
    "docker:migrate": "docker compose -f infra/docker-compose.yml --env-file .env run --rm migrate",
    "docker:up": "docker compose -f infra/docker-compose.yml --env-file .env up -d --build",
    "docker:down": "docker compose -f infra/docker-compose.yml --env-file .env down",
    "docker:logs": "docker compose -f infra/docker-compose.yml --env-file .env logs -f",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@scalar/hono-api-reference": "^0.12.18",
    "hono": "^4.11.1",
    "jose": "^6.1.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/bun": "^1.3.3",
    "husky": "^9.1.7",
    "typescript": "^5.9.3"
  }
}
