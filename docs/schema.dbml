// Comandô database schema
//
// Current state after migrations 001 through 005.
// Money is always stored as integer minor units (cents). Timestamps are UTC (`timestamptz`).
// This file is documentation: PostgreSQL remains the source of truth.

Enum order_type {
  COUNTER
  TABLE
}

Enum order_status {
  OPEN
  AWAITING_PAYMENT
  CLOSED
  CANCELED
}

Enum payment_method {
  CASH
  DEBIT_CARD
  CREDIT_CARD
  PIX
  OTHER
}

Enum order_adjustment_type {
  DISCOUNT
  SURCHARGE
}

Enum order_adjustment_mode {
  PERCENT
  FIXED
}

// Staff accounts. Users are never physically deleted: `deleted_at` deactivates them and
// historical orders keep a valid reference. Only the password hash is stored.
Table users {
  id bigint [pk, increment, note: 'BIGINT GENERATED BY DEFAULT AS IDENTITY']
  name varchar(160) [not null]
  email varchar(254) [not null, unique, name: 'users_email_unique']
  password_hash text [not null, note: 'Argon2id hash; never a plaintext password']
  deleted_at timestamptz [null, note: 'Soft delete/deactivation marker']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Note: 'Application users with one or more roles. Disabled users cannot authenticate; already-issued tokens stop working because the actor is reloaded from this table.'
}

// Role catalog seeded by the initial migration. Permissions are derived from these codes.
Table roles {
  id bigint [pk, increment]
  code varchar(32) [not null, unique, name: 'roles_code_unique', note: 'CHECK code IN (ADMIN, CASHIER, SERVER)']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Note: 'Fixed role catalog. A user may hold several roles; effective permissions are the union of their roles.'
}

// Many-to-many assignment between users and roles.
Table user_roles {
  user_id bigint [not null]
  role_id bigint [not null]
  assigned_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (user_id, role_id) [pk, name: 'user_roles_pk']
  }

  Note: 'Role assignments for a user. A user can hold multiple roles at the same time.'
}

// Sellable catalog. Removal is soft (`deleted_at`) and `active` controls whether the item
// can currently be sold. Historical order lines keep their own snapshots.
Table items {
  id bigint [pk, increment]
  name varchar(160) [not null]
  description text [null]
  price_cents bigint [not null, note: 'Current catalog price in cents; CHECK >= 0']
  image_url text [null]
  category varchar(80) [not null, default: 'Uncategorized', note: 'CHECK length(trim(category)) > 0']
  active boolean [not null, default: true, note: 'Sellable switch. Inactive items stay editable but cannot be sold']
  deleted_at timestamptz [null, note: 'Soft removal from the catalog']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (category, name) [name: 'items_sellable_category_idx', note: 'Partial: WHERE deleted_at IS NULL AND active']
  }

  Note: 'Catalog item. Price changes affect only future order lines; existing orders keep unit-price snapshots.'
}

// Single order model for both channels. COUNTER orders are inserted directly as CLOSED;
// TABLE orders move through OPEN -> AWAITING_PAYMENT -> CLOSED or CANCELED.
// Pricing columns snapshot the adjustment and service fee applied to the order.
Table orders {
  id bigint [pk, increment]
  order_type order_type [not null]
  status order_status [not null]
  total_amount_cents bigint [not null, default: 0, note: 'Server-calculated total in cents; CHECK >= 0']
  table_code varchar(64) [null, note: 'Required for TABLE, forbidden for COUNTER']
  label varchar(160) [null, note: 'Customer label; COUNTER only']
  opened_by_user_id bigint [not null]
  closed_by_user_id bigint [null, note: 'Required when status = CLOSED']
  canceled_by_user_id bigint [null, note: 'Required when status = CANCELED']
  payment_requested_at timestamptz [null, note: 'Set when the order enters AWAITING_PAYMENT']
  payment_requested_by_user_id bigint [null, note: 'Must be set together with payment_requested_at']
  adjustment_type order_adjustment_type [null, note: 'DISCOUNT or SURCHARGE; must be set together with adjustment_mode']
  adjustment_mode order_adjustment_mode [null, note: 'PERCENT or FIXED']
  adjustment_value bigint [not null, default: 0, note: 'Basis points for PERCENT, cents for FIXED; CHECK >= 0 and <= 10000 for PERCENT']
  adjustment_cents bigint [not null, default: 0, note: 'Signed result: negative for DISCOUNT, positive for SURCHARGE']
  apply_service_fee boolean [not null, default: false]
  service_fee_basis_points integer [not null, default: 0, note: 'Snapshotted fee rate; CHECK 0..10000']
  service_fee_cents bigint [not null, default: 0, note: 'Snapshotted fee amount; CHECK >= 0']
  opened_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  closed_at timestamptz [null, note: 'Required when status = CLOSED']
  canceled_at timestamptz [null, note: 'Required when status = CANCELED']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  version integer [not null, default: 1, note: 'Optimistic concurrency token; CHECK > 0']

  indexes {
    (created_at, id) [name: 'orders_history_idx', note: 'Descending: history pages newest first']
    (status, created_at, id) [name: 'orders_status_created_idx', note: 'created_at DESC, id DESC']
    closed_at [name: 'orders_closed_at_idx', note: 'Partial: WHERE status = CLOSED']
    canceled_at [name: 'orders_canceled_at_idx', note: 'Partial: WHERE status = CANCELED']
    table_code [unique, name: 'orders_one_active_per_table_idx', note: 'Partial unique: one TABLE order per table_code while status IN (OPEN, AWAITING_PAYMENT)']
  }

  Note: 'One order concept for counter sales and table service. Lifecycle, actor and timestamp checks are enforced by CHECK constraints. A TABLE order occupies its table while OPEN or AWAITING_PAYMENT.'
}

// Order lines. The composite key (order_id, item_id) guarantees one line per catalog item
// per order; adding the same item again updates quantity instead of inserting a duplicate.
Table order_items {
  order_id bigint [not null]
  item_id bigint [not null]
  item_name_snapshot varchar(160) [not null, note: 'Item name at order time']
  quantity integer [not null, note: 'CHECK > 0']
  unit_price_cents bigint [not null, note: 'Price snapshot at order time; CHECK >= 0']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (order_id, item_id) [pk, name: 'order_items_pk']
  }

  Note: 'Line of an order. Price and name are snapshotted so catalog changes never alter historical totals.'
}

// Payments applied to a closed order. Cash payments may also record the amount tendered
// and the change returned; both columns must be null or both set.
Table order_payments {
  id bigint [pk, increment]
  order_id bigint [not null]
  method payment_method [not null]
  amount_cents bigint [not null, note: 'CHECK > 0']
  received_cents bigint [null, note: 'Cash tendered; CASH only; CHECK >= amount_cents']
  change_cents bigint [null, note: 'Must equal received_cents - amount_cents']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    order_id [name: 'order_payments_order_id_idx']
  }

  Note: 'Payment methods and amounts of a closed order. The application requires payments to sum exactly to the order total (zero-total orders need none).'
}

// Opaque refresh tokens. Only a SHA-256 hash is stored. Tokens are rotated on use,
// revoked on logout/reuse, and invalidated when the user is deactivated.
Table refresh_tokens {
  id bigint [pk, increment]
  user_id bigint [not null]
  token_hash text [not null, unique, name: 'refresh_tokens_hash_unique', note: 'SHA-256 hash only; never the token itself']
  expires_at timestamptz [not null, note: 'CHECK expires_at > created_at']
  revoked_at timestamptz [null]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (user_id, expires_at) [name: 'refresh_tokens_user_active_idx', note: 'Partial: WHERE revoked_at IS NULL']
  }

  Note: 'Refresh-token persistence with rotation and revocation. Reusing a rotated token revokes every token of that user.'
}

// Persistent audit trail for administrative and order-lifecycle actions. Rows are written
// in the same transaction as the action, keeping technical request logs separate.
Table audit_logs {
  id bigint [pk, increment]
  actor_user_id bigint [null, note: 'SET NULL if the actor account is removed']
  action varchar(100) [not null, note: 'Examples: user.create, item.update, order.close, auth.refresh.reuse']
  target_type varchar(80) [not null, note: 'Entity kind, such as user, item, settings or order']
  target_id varchar(128) [null]
  request_id varchar(128) [null, note: 'Matches the X-Request-Id response header and request log']
  metadata jsonb [not null, default: `'{}'::jsonb`, note: 'Small non-sensitive context; never credentials or tokens']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    created_at [name: 'audit_logs_created_at_idx', note: 'Descending']
  }

  Note: 'Durable audit events. A rolled-back action leaves no row; a committed action always does.'
}

// Singleton application settings row (id is fixed at 1). Currently holds the service fee.
Table settings {
  id smallint [pk, default: 1, note: 'CHECK id = 1 enforces the singleton']
  service_fee_enabled boolean [not null, default: false]
  service_fee_basis_points integer [not null, default: 1000, note: '10% by default; CHECK 0..10000']
  updated_by_user_id bigint [null]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Note: 'Single row of application settings. Changing the service fee affects only new snapshots, never existing orders.'
}

// golang-migrate metadata, created and maintained by the migration runner.
Table schema_migrations {
  version bigint [pk]
  dirty boolean [not null]

  Note: 'Migration runner state, not a domain table. The application never reads or writes it.'
}

Ref: user_roles.user_id > users.id
Ref: user_roles.role_id > roles.id

Ref: orders.opened_by_user_id > users.id
Ref: orders.closed_by_user_id > users.id
Ref: orders.canceled_by_user_id > users.id
Ref: orders.payment_requested_by_user_id > users.id

Ref: order_items.order_id > orders.id
Ref: order_items.item_id > items.id

Ref: order_payments.order_id > orders.id

Ref: refresh_tokens.user_id > users.id

Ref: audit_logs.actor_user_id > users.id

Ref: settings.updated_by_user_id > users.id
